# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file (the repository is public).

# Supabase (local values: run `npm run status` in backend/)
# Only the anon key goes in the apps. Never put the service_role key in web or mobile.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Maps (Google Maps or Mapbox)
MAPS_API_KEY=

# Push notifications only (Firebase Cloud Messaging), later
FIREBASE_PROJECT_ID=
